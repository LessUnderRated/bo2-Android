index 223a055..9a506dd 100644
--- a/lib/Arch/X86/Semantics/CONVERT.cpp
+++ b/lib/Arch/X86/Semantics/CONVERT.cpp
@@ -82,12 +82,17 @@ DEF_ISEL(CVTPI2PD_XMMpd_MMXq) = CVTPI2PD<V64>;
 
 namespace {
 
+// bo2-native : XED declare la destination `rw` (les 64 bits hauts sont
+// conserves), donc le decodeur pousse DEUX operandes pour elle (ecriture puis
+// lecture), comme pour CVTSI2SS. L'ancienne signature a deux arguments ne
+// correspondait a aucune instruction decodee : chaque cvtpi2ps devenait
+// __remill_error.
 template <typename S>
-DEF_SEM(CVTPI2PS, V128W dst, S src) {
-  auto src_vec = UReadV32(src);
+DEF_SEM(CVTPI2PS, V128W dst, V128 src1, S src2) {
+  auto src_vec = UReadV32(src2);
   auto a = Float32(SExtractV32(src_vec, 0));
   auto b = Float32(SExtractV32(src_vec, 1));
-  FWriteV32(dst, FInsertV32(FInsertV32(FReadV32(dst), 0, a), 1, b));
+  FWriteV32(dst, FInsertV32(FInsertV32(FReadV32(src1), 0, a), 1, b));
   return memory;
 }
 
